# Outfox beta — one-box reverse proxy. Caddy terminates TLS (automatic certs),
# serves the built PWA, and proxies /api to the game server on loopback.
# Beta domain outfoxgame.com (Cloudflare DNS, unproxied, A/AAAA to the box). The box's
# Debian 13 caddy (2.6) needs the global acme_ca pinned to Let's Encrypt: its ZeroSSL
# fallback fails with caddy_legacy_user_removed.

{
	email rizki@imahpiksel.com
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

outfoxgame.com {
	encode zstd gzip

	# --- the API: game server, loopback only (server binds 127.0.0.1) ---
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	# --- liveness probe for uptime monitoring (unauthenticated by design) ---
	handle /healthz {
		reverse_proxy 127.0.0.1:8787
	}

	# --- TWA app-site association (Solana dApp Store listing) ---
	# Generated by bubblewrap when the APK exists; until then this 404s harmlessly.
	handle /.well-known/assetlinks.json {
		root * /srv/outfox/well-known
		file_server
	}

	# --- the PWA: static dist with SPA fallback ---
	handle {
		root * /srv/outfox/dist
		try_files {path} /index.html
		file_server
	}

	header {
		# clickjacking/MIME hardening; HSTS only once TLS is proven stable
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# service worker + hashed assets: let Vite's content hashes do cache busting
	}

	log {
		output file /var/log/caddy/outfox-access.log
		format json
	}
}

www.outfoxgame.com {
	redir https://outfoxgame.com{uri} permanent
}
