# /etc/outfox/server.env — production environment for the Outfox game server.
# PERMISSIONS: root:outfox 0640. OUTFOX_SIGNER_KEY is the HOT voucher key: it can
# sign real withdrawals up to the on-chain window cap. Fresh key per environment,
# never the admin key, never in the repo.

NODE_ENV=production
PORT=8787

# the SQLite ledger (systemd StateDirectory)
OUTFOX_DB=/var/lib/outfox/outfox.sqlite

# SIWS message domain — MUST match the public origin players see
OUTFOX_ORIGIN=outfoxgame.com

# Rate limiting keys on the client IP from X-Forwarded-For. Set to 1 ONLY behind
# Caddy (this deploy); on a directly-exposed server the header would be a
# spoofable rate-limit bypass — leave unset there.
OUTFOX_TRUST_PROXY=1

# ----- chain edge (devnet values for the beta; mainnet only behind the gates) -----
OUTFOX_RPC_URL=https://api.devnet.solana.com
OUTFOX_CHAIN_ID=1
OUTFOX_PROGRAM_ID=574eotmx4QLJ1F3eNjBDXa1tECFs2kXRpbYEEmP8U98y
# 32-byte ed25519 seed, hex or base58 (hot voucher key)
OUTFOX_SIGNER_KEY=REPLACE_ME
# The settlement's CURRENT cold admin (after a transfer_admin + accept_admin handover,
# the new one: update this line, or the next restart refuses every chain path). The server
# refuses a settlement state whose admin or voucher signer is not its own: someone else
# could have initialized the program id first. Required together with OUTFOX_SIGNER_KEY.
OUTFOX_ADMIN=REPLACE_ME
# The $ALPHA launch curve pool on Meteora (`pool` in launch.json, scripts/launch.ts).
# Optional: without it GET /api/launch answers null. The view is served only when this
# pool's mint is the settlement state's mint.
# OUTFOX_LAUNCH_POOL=

# ----- the Wire (Wire Calls on Panta markets; blank = the Wire is off) -----
# Panta API key (X-Api-Key). Never in the repo; set it in /etc/outfox only.
OUTFOX_PANTA_KEY=
# Any valid base58 pubkey for price quotes; it never signs anything. Blank = built-in default.
OUTFOX_PANTA_WALLET=
# Test and verify-live only: a JSON fixture replaces the Panta client. Refused in production.
OUTFOX_WIRE_FIXTURE=

# ----- OFF in any real deploy (defaults are off; listed so nobody turns them on) -----
# OUTFOX_DEV_AUTH=      # dev email+code sheet + /api/verify/dev — NEVER in production
# OUTFOX_DEBUG=         # /api/debug/* audit endpoints — NEVER in production
# OUTFOX_DEV_SEED_EXCHANGE=  # dev pool seeding; production seeding is an explicit
#                            # operator step through poolSeedFromDeposit (E6)
