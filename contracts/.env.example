# Copy to .env (gitignored). NEVER commit real values.
# OPSEC (repo CLAUDE.md rules 4/5): testnet deployer = fresh throwaway key funded
# from the public faucet or the canonical bridge only; mainnet deployer must have
# no funding path traceable to a KYC'd identity.

# Where the full 2,000,000 ALPHA cap is minted (release-side treasury address)
ALPHA_TREASURY=0x0000000000000000000000000000000000000000

# Game-server voucher signing key's ADDRESS (hot key — never the owner key)
SETTLEMENT_SIGNER=0x0000000000000000000000000000000000000000

# Ops owner (pause/setSigner/setWindowCap) — cold key, 2-step transfers
SETTLEMENT_OWNER=0x0000000000000000000000000000000000000000

# Global withdrawal cap per 24h window, in wei-scale ALPHA (e.g. 5000e18)
SETTLEMENT_WINDOW_CAP=5000000000000000000000

# Deploy examples:
#   forge script script/Deploy.s.sol --rpc-url robinhood_testnet \
#     --private-key $DEPLOYER_KEY --broadcast
# Verify the chain first: cast chain-id --rpc-url robinhood_testnet   # must be 46630
